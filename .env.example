# Скопируй в .env и впиши ключ
ANTHROPIC_API_KEY=

# Модели (необязательно). По умолчанию claude-sonnet-5-5
TEXTGEN_MODEL_ANALYSIS=claude-sonnet-5-5
TEXTGEN_MODEL_GENERATION=claude-sonnet-5-5
TEXTGEN_MODEL_CHECK=claude-sonnet-5-5

# Допуски проверок (необязательно)
TEXTGEN_WORDS_TOLERANCE=0.15
TEXTGEN_MAX_FIX_ITERATIONS=4
